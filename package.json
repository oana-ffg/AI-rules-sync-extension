{
  "name": "agent-rules-sync",
  "displayName": "Agent Rules Sync",
  "description": "Unified editor for syncing coding agent rule files (AGENTS.md, CLAUDE.md, .cursor/rules/project-rules.mdc)",
  "version": "1.2.0",
  "publisher": "FireFunGames",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oana-ffg/AI-rules-sync-extension"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, the list of rule files is only read from user settings so an untrusted workspace cannot choose which files are overwritten.",
      "restrictedConfigurations": [
        "agentRulesSync.ruleFiles"
      ]
    }
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentRulesSync.openRulesEditor",
        "title": "Open Agent Rules Editor",
        "category": "Agent Rules"
      },
      {
        "command": "agentRulesSync.addRuleFile",
        "title": "Add Agent Rule File",
        "category": "Agent Rules"
      },
      {
        "command": "agentRulesSync.removeRuleFile",
        "title": "Remove Agent Rule File",
        "category": "Agent Rules"
      }
    ],
    "configuration": {
      "title": "Agent Rules Sync",
      "properties": {
        "agentRulesSync.ruleFiles": {
          "type": "array",
          "default": [
            "AGENTS.md",
            "CLAUDE.md",
            ".cursor/rules/project-rules.mdc",
            ".github/copilot-instructions.md",
            ".roo/rules/rules.md",
            ".windsurfrules"
          ],
          "description": "List of agent rule files to sync",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "keybindings": [
      {
        "command": "agentRulesSync.openRulesEditor",
        "key": "cmd+shift+r",
        "when": "isMac && editorTextFocus"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "agentRulesSync.openRulesEditor",
          "group": "2_workspace"
        }
      ],
      "editor/context": [
        {
          "command": "agentRulesSync.openRulesEditor",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/extension.test.cjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "~1.74.0",
    "@vscode/vsce": "^4.1.0",
    "typescript": "^5.9.3"
  }
}
